# Copie para .env e preencha. O .env nunca vai para o repositório.

# Acelerato — conta da API, token e instância
ACELERATO_URL_BASE=https://SUA-INSTANCIA.acelerato.com/api/publica
EMAIL_ACELERATO=
TOKEN_ACELERATO=
# quem aparece como solicitante do chamado
ACELERATO_EMAIL_SOLICITANTE=
# categoria do chamado; tem que ser categoria folha, senão a API recusa
ACELERATO_CATEGORIA_KEY=
# quem entra em cópia em todo chamado, além dos gestores (separar por vírgula)
ACELERATO_SEGUIDORES_FIXOS=

# Banco do RH — admitidos e chefia das lojas
RH_FONTE_DB_NAME=
RH_FONTE_DB_USER=
RH_FONTE_DB_PASSWORD=
RH_FONTE_DB_HOST=
RH_FONTE_DB_PORT=

# Banco do MPCore — vagas e perfis de acesso
MPCORE_DB_NAME=
MPCORE_DB_USER=
MPCORE_DB_PASSWORD=
MPCORE_DB_HOST=
MPCORE_DB_PORT=
